---
import "../styles/global.css";
import BrandMark from "../components/BrandMark.astro";

const parts = [
  { id: "startups", number: "01", label: "YOUR PRODUCTS", title: "Your startups", text: "Each app has its own Git repository, code and deployment configuration. Keep several projects together in your workspace while developing and shipping each independently.", examples: ["Your app", "Your repo", "Your deployment"] },
  { id: "tooling", number: "02", label: "THE SHARED TOOLS", title: "Shared tooling", text: "The Startup CLI handles setup and operations. Deployment workflows and other public tooling are cloned into your Factory so you can inspect them, learn from them and contribute improvements.", examples: ["Startup CLI", "Deployment workflows", "Public source"] },
  { id: "skills", number: "03", label: "GUIDANCE FOR YOUR AGENT", title: "Agent skills", text: "Reusable instructions teach your coding agent how to deploy, review an idea or prepare a task. Core skills are installed during setup for configured agents; additional integrations are optional.", examples: ["Deploy a startup", "Review an idea", "Prepare a task"] },
  { id: "templates", number: "04", label: "A WORKING STARTING POINT", title: "Project templates", text: "Start with an app foundation: services, agent instructions, checks and deployment setup. The generated project becomes your own repo. Review and apply template updates when you choose.", examples: ["Django / FastAPI", "Vue + backend", "Astro landing page"] },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>Inside the Factory — Deploy Your Startup</title>
    <meta name="description" content="A quick tour of your Startup Factory: your own workspace and repositories, shared tooling, agent skills and project templates." />
  </head>
  <body class="factory-page">
    <div class="page-shell">
      <header>
        <a class="brand" href="/" aria-label="Deploy Your Startup home"><span class="brand-symbol"><BrandMark /></span><span>deploy your<strong>startup</strong></span></a>
        <nav aria-label="Main navigation"><a href="/faq">FAQ</a><a href="/get-started">Get started <span aria-hidden="true">↗</span></a></nav>
      </header>
      <main>
        <section class="hero" aria-labelledby="factory-title">
          <p class="eyebrow">INSIDE THE FACTORY</p>
          <h1 id="factory-title">One workspace.<br /><span>Room for every idea.</span></h1>
          <p class="intro">Your projects, the tools to ship them, and the knowledge<br class="desktop-break" /> your agent needs. Here’s how the pieces fit together.</p>
        </section>

        <section class="workspace" aria-labelledby="workspace-title">
          <div class="workspace-copy">
            <span class="workspace-mark" aria-hidden="true"><BrandMark /></span>
            <p class="eyebrow">THE PLACE IT ALL COMES TOGETHER</p>
            <h2 id="workspace-title">Your Factory</h2>
            <p>A workspace on your computer, with its own Git repository and an optional private GitHub backup.</p>
            <p>It keeps track of your portfolio and shared instructions. Your startups and tooling keep their own repository histories.</p>
            <span class="ownership-note"><span aria-hidden="true">↳</span> Your portfolio stays yours.</span>
          </div>
          <nav class="workspace-tree" aria-label="Factory components">
            <div class="tree-heading"><span class="folder" aria-hidden="true"></span><strong>my-factory/</strong><span class="repo-label">YOUR REPO</span></div>
            <div class="tree-branches">
              <div class="tree-item registry"><code>projects.yaml</code><span>Your project registry</span></div>
              <a class="tree-item" href="#startups"><code>projects/startups/</code><span>Independent app repos <b aria-hidden="true">↗</b></span></a>
              <a class="tree-item" href="#tooling"><code>projects/tooling/</code><span>Public tools & templates <b aria-hidden="true">↗</b></span></a>
              <a class="tree-item" href="#skills"><code>skills/</code><span>Reusable agent guidance <b aria-hidden="true">↗</b></span></a>
            </div>
            <p class="tree-note">A simplified view of your workspace.</p>
          </nav>
        </section>

        <section class="parts" aria-label="The parts of your Factory">
          {parts.map(part => <article id={part.id}>
            <div class="part-label"><span>{part.number}</span><p>{part.label}</p></div>
            <h2>{part.title}</h2>
            <p class="part-description">{part.text}</p>
            <ul aria-label={`${part.title} examples`}>{part.examples.map(example => <li>{example}</li>)}</ul>
          </article>)}
        </section>

        <aside class="optional" aria-labelledby="sprowi-title">
          <span class="optional-symbol" aria-hidden="true">↻</span>
          <div><p class="eyebrow">OPTIONAL · EXTRA SETUP</p><h2 id="sprowi-title">Sprowi, when you want to automate more.</h2><p>An agent loop for idea discovery and implementation tasks. Set it up separately when it fits your workflow; you can build and deploy without it.</p></div>
        </aside>

        <section class="next-step" aria-labelledby="next-title">
          <div><h2 id="next-title">Start with one idea.</h2><p>The guided setup creates your Factory and helps you start your first project.</p><a class="faq-link" href="/faq">Ownership & access FAQ <span aria-hidden="true">↗</span></a></div>
          <a class="start-link" href="/get-started">Get started <span aria-hidden="true">↗</span></a>
        </section>
      </main>
      <footer><a href="/">deploy-your-startup.com</a><a href="https://github.com/Deploy-your-Startup/startup-factory-template">Explore the Factory template ↗</a></footer>
    </div>
  </body>
</html>

<style>
  :global(body.factory-page) { background: #18191b; color: #e7e7e4; padding: 0 1.5rem; --accent-2: #a9c5df; --muted: #aeb2b8; --text: #e7e7e4; }
  .page-shell { width: 100%; max-width: 920px; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.6rem 0; border-bottom: 1px solid #ffffff12; }
  .brand { display: flex; align-items: center; gap: .65rem; text-decoration: none; color: #aeb2b8; font-size: .7rem; }
  .brand-symbol { width: 45px; color: #a9c5df; transition: transform .25s; }
  .brand-symbol :global(svg) { display: block; width: 100%; }
  .brand:hover .brand-symbol { transform: translate(1px, -2px); }
  .brand strong { display: block; color: #e7e7e4; font-size: 1.15rem; font-weight: 600; letter-spacing: -.05em; }
  header nav { display: flex; gap: 1.6rem; }
  header nav a { text-decoration: none; font-size: .75rem; padding-block: .7rem; }
  header nav a:first-child { color: #aeb2b8; }
  .hero { padding: 4rem 0 3rem; }
  .eyebrow { font: .6rem "JetBrains Mono", monospace; letter-spacing: .12em; color: #a9c5df; margin-bottom: 1.2rem; line-height: 1.8; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.1rem); font-weight: 600; letter-spacing: -.06em; line-height: 1.1; background: none; -webkit-text-fill-color: currentColor; margin: 0; }
  h1 span { color: #a9c5df; }
  .intro { font-size: .9rem; line-height: 1.8; color: #aeb2b8; margin-top: 1.5rem; }
  h2 { font-size: 1.4rem; font-weight: 600; letter-spacing: -.04em; line-height: 1.3; }
  .workspace { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; padding: 2rem; background: radial-gradient(ellipse at 0 0, #a9c5df09, transparent 65%), #141517; border: 1px solid #34383f; border-radius: 12px; }
  .workspace-mark { display: block; width: 44px; color: #a9c5df; margin-bottom: .8rem; }
  .workspace-mark :global(svg) { display: block; width: 100%; }
  .workspace-copy .eyebrow { font-size: .5rem; margin-bottom: .6rem; }
  .workspace-copy > p:not(.eyebrow) { font-size: .8rem; line-height: 1.85; color: #b7bbc3; margin-top: .9rem; }
  .ownership-note { display: block; margin-top: 1.2rem; font-size: .75rem; color: #a9c5df; }
  .ownership-note > span { margin-right: .4rem; }
  .workspace-tree { align-self: center; min-width: 0; }
  .tree-heading { display: flex; align-items: center; gap: .65rem; margin-bottom: 1.15rem; }
  .tree-heading strong { font: .85rem "JetBrains Mono", monospace; }
  .repo-label { margin-left: auto; font: .5rem "JetBrains Mono", monospace; color: #a9c5df; letter-spacing: .05em; }
  .folder { width: 17px; height: 13px; border: 1px solid #a9c5df; border-radius: 2px; position: relative; }
  .folder::before { content: ''; position: absolute; left: -1px; top: -4px; width: 7px; height: 3px; border: 1px solid #a9c5df; border-bottom: 0; border-radius: 2px 2px 0 0; }
  .tree-branches { margin-left: 8px; padding-left: 1.2rem; border-left: 1px solid #404c59; }
  .tree-item { display: block; position: relative; padding: .7rem .8rem; margin-bottom: .5rem; border: 1px solid #333940; border-radius: 5px; text-decoration: none; background: #1b1e22; transition: transform .2s, border-color .2s; animation: branch-in .5s ease both; }
  .tree-item:nth-child(2) { animation-delay: .1s; }
  .tree-item:nth-child(3) { animation-delay: .2s; }
  .tree-item:nth-child(4) { animation-delay: .3s; }
  .tree-item::before { content: ''; position: absolute; right: 100%; top: 50%; width: 1.2rem; height: 1px; background: #404c59; }
  a.tree-item:hover, a.tree-item:focus-visible { transform: translateX(3px); border-color: #91adc5; }
  .tree-item code { font-size: .7rem; color: #d5e1ec; }
  .tree-item > span { display: flex; align-items: center; justify-content: space-between; color: #aeb2b8; font-size: .65rem; line-height: 1.7; margin-top: .25rem; }
  .tree-item b { color: #a9c5df; font-weight: 400; }
  .registry { background: transparent; border-color: transparent; }
  .registry code { color: #bdc1c8; }
  .tree-note { color: #aeb2b8; font-size: .6rem; margin: .9rem 0 0 1.2rem; line-height: 1.6; }
  .parts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 3rem; margin-top: 1.5rem; }
  article { padding: 2rem 0; border-bottom: 1px solid #343639; scroll-margin-top: 2rem; }
  .part-label { display: flex; align-items: baseline; gap: .7rem; margin-bottom: .8rem; font: .55rem "JetBrains Mono", monospace; letter-spacing: .08em; color: #aeb2b8; }
  .part-label > span { color: #a9c5df; }
  .part-description { color: #b7bbc3; font-size: .8rem; line-height: 1.9; margin-top: .9rem; }
  article ul { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: 1rem; list-style: none; }
  article li { color: #a9c5df; font-size: .65rem; line-height: 1.7; }
  article li::before { content: '·'; margin-right: .4rem; color: #aeb2b8; }
  .optional { display: flex; gap: 1rem; margin: 2rem 0; padding: 1.2rem 1.5rem; border: 1px dashed #414850; border-radius: 8px; }
  .optional-symbol { font-size: 1.5rem; color: #a9c5df; }
  .optional .eyebrow { margin-bottom: .4rem; font-size: .5rem; }
  .optional h2 { font-size: 1rem; letter-spacing: -.02em; }
  .optional p:last-child { font-size: .75rem; color: #aeb2b8; line-height: 1.8; margin-top: .6rem; }
  .next-step { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1rem 0 2.5rem; }
  .next-step p { font-size: .8rem; color: #aeb2b8; line-height: 1.8; margin: .7rem 0; }
  .faq-link { display: inline-block; font-size: .75rem; text-decoration: none; padding-block: .5rem; }
  .start-link { background: #a9c5df; color: #18212a; padding: .9rem 1.2rem; font-size: .8rem; font-weight: 600; border-radius: 6px; text-decoration: none; white-space: nowrap; transition: transform .2s, background .2s; }
  .start-link:hover { background: #c6ddf1; transform: translateY(-2px); }
  .start-link span { margin-left: .7rem; }
  footer { display: flex; flex-direction: row; justify-content: space-between; gap: 1rem; margin: 0; padding: 1.5rem 0 2.5rem; border-top: 1px solid #343639; text-align: left; font-size: .6rem; line-height: 1.8; letter-spacing: 0; }
  footer a { text-decoration: none; }
  footer a:first-child { color: #aeb2b8; }
  @keyframes branch-in { from { opacity: .3; transform: translateX(-5px); } to { opacity: 1; transform: translateX(0); } }
  @media (max-width: 650px) {
    header nav { gap: 1rem; }
    header nav a { font-size: .7rem; }
    .hero { padding: 3rem 0 2rem; }
    .desktop-break { display: none; }
    .workspace { grid-template-columns: 1fr; padding: 1.3rem; gap: 2rem; }
    .parts { grid-template-columns: 1fr; margin-top: .5rem; }
    article { padding: 1.6rem 0; }
    .next-step { align-items: flex-start; flex-direction: column; }
    .optional { padding: 1.2rem; }
    footer { flex-direction: column; align-items: flex-start; }
  }
</style>
