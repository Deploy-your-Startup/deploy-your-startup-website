---
import "../styles/global.css";

const baseDomain = "deploy-your-startup.com";
import Command from "../components/Command.astro";
import { installCommand } from "../config";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>Deploy Your Startup — Try the early access CLI</title>
    <meta
      name="description"
      content="Install the early access CLI and deploy your own Django/FastAPI application, database and HTTPS on Hetzner. Your code, your GitHub account, your infrastructure."
    />
  </head>
  <body>
    <div class="grid"></div>
    <main class="container">
      <span class="badge"><span class="pulse"></span>Early access · macOS</span>
      <h1>Deploy your<br />startup in minutes.</h1>
      <p class="subtitle">
        Your code. Your servers. <strong>Ready to ship.</strong>
      </p>
      <Command id="install-code" command={installCommand} label="Install the CLI" />
      <p class="install-note">macOS · <a href="https://docs.astral.sh/uv/getting-started/installation/" target="_blank" rel="noopener">uv</a> + Git</p>
      <nav class="start-links" aria-label="Getting started">
        <a class="primary-link" href="/get-started">Get started <span aria-hidden="true">→</span></a>
        <a href="https://github.com/Deploy-your-Startup/cli" target="_blank" rel="noopener">View source</a>
      </nav>
      <p class="tease">
        <strong>AI-ready from the first commit.</strong> Build one startup. Then the next.
      </p>
      <div class="pills">
        <span class="pill"><span class="dot"></span>Zero to prod in minutes</span>
        <span class="pill"><span class="dot"></span>AI-ready by default</span>
        <span class="pill"><span class="dot"></span>Build a startup factory</span>
      </div>
      <div class="factory">
        <span class="stack-label">The startup factory</span>
        <div class="line">
          <div class="rail"><span class="spark"></span></div>

          <div class="station">
            <span class="node node-agent" title="You - the AI agent - drive the whole line">
              <span class="glyph">&#10022;</span>
            </span>
            <span class="step step-agent">agent</span>
          </div>

          <a
            class="station"
            href="https://github.com"
            target="_blank"
            rel="noopener"
            title="GitHub"
          >
            <span class="node" style="--logo: url('https://cdn.simpleicons.org/github')">
              <span class="icon"></span>
            </span>
            <span class="step">commit</span>
          </a>

          <a
            class="station"
            href="https://www.ansible.com"
            target="_blank"
            rel="noopener"
            title="Ansible - provisions your infrastructure"
          >
            <span class="node" style="--logo: url('https://cdn.simpleicons.org/ansible')">
              <span class="icon"></span>
            </span>
            <span class="step">provision</span>
          </a>

          <a
            class="station"
            href="https://www.hetzner.com/cloud"
            target="_blank"
            rel="noopener"
            title="Hetzner Cloud - your servers"
          >
            <span class="node" style="--logo: url('https://cdn.simpleicons.org/hetzner')">
              <span class="icon"></span>
            </span>
            <span class="step">servers</span>
          </a>

          <a
            class="station"
            href="https://k3s.io"
            target="_blank"
            rel="noopener"
            title="k3s - the operating system of your cloud"
          >
            <span class="node" style="--logo: url('https://cdn.simpleicons.org/k3s')">
              <span class="icon"></span>
            </span>
            <span class="step">cloud os</span>
          </a>

          <div class="station">
            <span class="node node-stack" title="The technology you choose - Django, FastAPI, NestJS, Vue, your call">
              <span class="reel">
                <span class="icon stack-icon" style="--logo: url('https://cdn.simpleicons.org/django')"></span>
                <span class="icon stack-icon" style="--logo: url('https://cdn.simpleicons.org/fastapi')"></span>
                <span class="icon stack-icon" style="--logo: url('https://cdn.simpleicons.org/nestjs')"></span>
                <span class="icon stack-icon" style="--logo: url('https://cdn.simpleicons.org/vuedotjs')"></span>
                <span class="icon stack-icon" style="--logo: url('https://cdn.simpleicons.org/django')"></span>
              </span>
            </span>
            <span class="step">your stack</span>
          </div>

          <div class="station">
            <span class="node node-live" title="Your startup, live">
              <span class="ring"></span>
              <span class="glyph">&#9650;</span>
            </span>
            <span class="step step-live">live</span>
          </div>
        </div>
        <p class="factory-note">
          Your stack. Your repo. <strong>Ready to grow.</strong>
        </p>
      </div>
      <p class="control">
        Code, infrastructure and deployments live in <strong>your own accounts</strong>.
        Change anything. You hold the keys.
      </p>
      <section class="pricing">
        <span class="stack-label">Fair by design</span>
        <div class="pills">
          <span class="pill"><span class="dot"></span>your Hetzner bill</span>
          <span class="pill"><span class="dot"></span>your domain</span>
          <span class="pill"><span class="dot"></span>your coding agents</span>
        </div>
        <p class="pricing-note">
          <strong>No platform fee during early access.</strong> Pay your providers directly.
        </p>
      </section>
    </main>
    <footer>
      <span class="domain">{baseDomain}</span>
      <a class="made-by" href="https://aboutphil.de" target="_blank" rel="noopener">
        Made with <span class="heart">&#9829;</span> from aboutphil
      </a>
    </footer>
    <script>
      function resetAnimations() {
        const els = document.querySelectorAll('.spark, .node, .node-live .ring, .node-stack .reel');
        els.forEach(el => {
          (el as HTMLElement).style.animationName = 'none';
          void (el as HTMLElement).offsetWidth;
          (el as HTMLElement).style.animationName = '';
        });
      }

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('orientationchange', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resetAnimations, 300);
      });
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resetAnimations, 300);
      });
    </script>
  </body>
</html>
