---
import "../styles/global.css";

const baseDomain = "deploy-your-startup.com";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>Deploy Your Startup - Coming Soon</title>
    <meta
      name="description"
      content="Deploy Your Startup is launching soon with opinionated tooling for solo founders and small teams."
    />
  </head>
  <body>
    <div class="grid"></div>
    <main class="container">
      <span class="badge"><span class="pulse"></span>Coming Soon</span>
      <h1>Deploy your<br />startup in minutes.</h1>
      <p class="subtitle">
        From zero to a running production cluster - opinionated tooling for solo founders and small teams who'd rather ship than wrangle YAML.
      </p>
      <code class="cli">
        <span class="prompt">$</span> <span class="cmd">startup bootstrap</span><span
          class="cursor"></span>
      </code>
      <div class="stack">
        <span class="stack-label">Built on</span>
        <div class="stack-logos">
          <a
            href="https://www.hetzner.com/cloud"
            target="_blank"
            rel="noopener"
            title="Hetzner Cloud"
            style="--logo: url('https://cdn.simpleicons.org/hetzner')"
          >
            <span class="icon"></span>
          </a>
          <a
            href="https://k3s.io"
            target="_blank"
            rel="noopener"
            title="k3s"
            style="--logo: url('https://cdn.simpleicons.org/k3s')"
          >
            <span class="icon"></span>
          </a>
          <a
            href="https://www.ansible.com"
            target="_blank"
            rel="noopener"
            title="Ansible"
            style="--logo: url('https://cdn.simpleicons.org/ansible')"
          >
            <span class="icon"></span>
          </a>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener"
            title="GitHub"
            style="--logo: url('https://cdn.simpleicons.org/github')"
          >
            <span class="icon"></span>
          </a>
        </div>
      </div>
    </main>
    <footer>{baseDomain}</footer>
  </body>
</html>
