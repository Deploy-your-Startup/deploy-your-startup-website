---
interface Props { id: string; command: string; label?: string; compact?: boolean }
const { id, command, label = "Terminal", compact = false } = Astro.props;
---
<div class:list={["install-shell", { "compact-command": compact }]}>
  <div class="shell-heading">
    <span>{label}</span>
    <button type="button" data-copy={id} data-state="idle" aria-label={`Copy ${label.toLowerCase()} command`}>
      <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path class="copy-back" d="M8 16H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2" />
        <rect class="copy-front" x="8" y="8" width="12" height="12" rx="2" />
        <path class="copy-check" d="m6 12 4 4 8-8" />
      </svg>
      <span class="copy-label">Copy</span>
    </button>
    <span class="copy-status" role="status" aria-live="polite"></span>
  </div>
  <Fragment set:html="<!--email_off-->" />
  <pre><code id={id}>{command}</code></pre>
  <Fragment set:html="<!--/email_off-->" />
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    const label = button.querySelector<HTMLElement>('.copy-label');
    const status = button.parentElement?.querySelector<HTMLElement>('.copy-status');
    let resetTimer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      clearTimeout(resetTimer);
      const code = document.getElementById(button.dataset.copy ?? '');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.dataset.state = 'copied';
        if (label) label.textContent = 'Copied';
        if (status) status.textContent = 'Command copied to clipboard.';
        document.dispatchEvent(new CustomEvent('command-copied', { detail: { id: code.id } }));
      } catch {
        button.dataset.state = 'fallback';
        if (label) label.textContent = 'Select to copy';
        if (status) status.textContent = 'Command selected. Copy it with your keyboard.';
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      resetTimer = setTimeout(() => {
        button.dataset.state = 'idle';
        if (label) label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
